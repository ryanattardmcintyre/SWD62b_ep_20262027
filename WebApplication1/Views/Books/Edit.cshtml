@model Common.Models.Book

@{
    ViewData["Title"] = "Edit Book";

    var categories = ViewBag.Categories;


}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <h2 class="mb-4">Edit Book</h2>

            <form action="/Books/Edit"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <!-- ISBN -->
                <div class="mb-3">
                    <label asp-for="Isbn"
                           class="form-label"></label>

                    <input asp-for="Isbn"
                           class="form-control"
                           readonly />

                    <span asp-validation-for="Isbn"
                          class="text-danger"></span>
                </div>

                <!-- Title -->
                <div class="mb-3">
                    <label asp-for="Title"
                           class="form-label"></label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <!-- Author -->
                <div class="mb-3">
                    <label asp-for="Author"
                           class="form-label"></label>

                    <input asp-for="Author"
                           class="form-control" />

                    <span asp-validation-for="Author"
                          class="text-danger"></span>
                </div>

                <!-- Volume -->
                <div class="mb-3">
                    <label asp-for="Volume"
                           class="form-label"></label>

                    <input asp-for="Volume"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="Volume"
                          class="text-danger"></span>
                </div>

                <!-- Category -->
                <div class="mb-3">
                    <label asp-for="CategoryFK"
                           class="form-label">Category</label>

                    <select name="CategoryFK"
                            class="form-select">
                        <option value="-1">-- Select Category --</option>
                        @foreach(var c in ViewBag.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>

                    <span asp-validation-for="CategoryFK"
                          class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label"></label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <!-- Available -->
                <div class="form-check mb-3">
                    <input asp-for="Available"
                           class="form-check-input" />

                    <label asp-for="Available"
                           class="form-check-label">
                        Available
                    </label>
                </div>

                <!-- Current Cover -->
                @if (!string.IsNullOrEmpty(Model.Cover))
                {
                    <div class="mb-3">
                        <label class="form-label">
                            Current Cover
                        </label>

                        <div>
                            <img src="@Url.Content(Model.Cover)"
                                 alt="Book Cover"
                                 class="img-thumbnail"
                                 style="max-height: 200px;" />
                        </div>
                    </div>
                }

                <!-- Upload New Cover -->
                <div class="mb-3">
                    <label for="file" class="form-label">
                        Upload New Cover
                    </label>

                    <input type="file"
                           id="file"
                           name="file"
                           accept="image/*"
                           class="form-control" />

                    <div class="form-text">
                        Leave empty to keep the current cover.
                    </div>
                </div>

                <!-- Keep existing cover path -->
                <input type="hidden" asp-for="Cover" />

                <!-- Buttons -->
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Books"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
